#!/usr/bin/env bash
# Build gate: compiles the app, unit tests and instrumented tests before anything is pushed.
# Install with scripts/install-hooks.sh. Skip once with `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: building the app and test sources…"
if ! ./gradlew --quiet :app:assembleDebug :app:compileDebugUnitTestKotlin :app:compileDebugAndroidTestKotlin; then
  echo "pre-push: build failed; push aborted." >&2
  exit 1
fi
echo "pre-push: build OK"
